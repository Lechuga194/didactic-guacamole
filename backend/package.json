{
	"name": "cocina-backend",
	"version": "1.0.0",
	"private": true,
	"description": "API de costeo y ventas para dark kitchen",
	"main": "dist/app.js",
	"scripts": {
		"start": "nodemon",
		"build": "tsc",
		"serve": "node dist/app.js",
		"lint": "eslint src",
		"format": "prettier --write \"src/**/*.ts\"",
		"test": "node --test --require ts-node/register src/**/*.test.ts"
	},
	"dependencies": {
		"@tesseract.js-data/eng": "^1.0.0",
		"@tesseract.js-data/spa": "^1.0.0",
		"better-sqlite3": "^13.0.3",
		"cors": "^2.8.6",
		"dotenv": "^18.0.8",
		"exceljs": "^4.4.0",
		"express": "^5.3.0",
		"express-rate-limit": "^8.7.1",
		"joi": "^18.3.0",
		"knex": "^3.3.0",
		"multer": "^2.4.0",
		"socket.io": "^4.8.4",
		"tesseract.js": "^7.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/multer": "^2.3.0",
		"@types/node": "^26.6.5",
		"eslint": "^10.13.0",
		"nodemon": "^3.1.14",
		"prettier": "^3.9.10",
		"ts-node": "^10.9.2",
		"typescript": "~5.9",
		"typescript-eslint": "^8.71.2"
	},
	"allowScripts": {
		"better-sqlite3@13.0.3": true
	}
}

