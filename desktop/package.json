{
  "name": "cocina-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "App de escritorio (Electron) de Cocina: costeo, ventas y portales de plataformas",
  "scripts": {
    "stage": "node scripts/stage.js",
    "seed": "node scripts/seed.js",
    "postinstall": "node node_modules/electron/install.js",
    "start": "npm run stage && electron build/app",
    "dist:mac": "npm run stage && electron-builder --mac --universal",
    "dist:win": "npm run stage && electron-builder --win",
    "pack": "npm run stage && electron-builder --dir"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "allowScripts": {
    "electron@44.9.0": true
  }
}
